; nondeterministic steps, a free input and a boolean that tracks parity of visits above 3
(declare-fun x () Int)
(declare-fun x.n () Int)
(declare-fun y () Int)
(declare-fun y.n () Int)
(declare-fun b () Bool)
(declare-fun b.n () Bool)
(declare-fun i () Int)
(define-fun .x () Int (! x :next x.n))
(define-fun .y () Int (! y :next y.n))
(define-fun .b () Bool (! b :next b.n))
(define-fun .init () Bool (! (and (= x 0) (= y 0) (not b)) :init true))
(define-fun .trans () Bool (! (and (=> (< x 6) (or (= x.n (+ x 1)) (= x.n (+ x 2))))
                                   (=> (>= x 6) (= x.n x))
                                   (= y.n (ite (and (>= i 0) (<= i 3)) i y))
                                   (= b.n (xor b (> x 3))))
                              :trans true))
(define-fun .p0 () Bool (! (< x 8) :invar-property 0))
(define-fun .p1 () Bool (! (not (and b (= y 3) (= x 7))) :invar-property 1))
