; two counters moved by separate events, given as a disjunctive transition relation
(declare-fun x () Int)
(declare-fun |x'| () Int)
(declare-fun y () Int)
(declare-fun |y'| () Int)
(define-fun .x () Int (! x :next |x'|))
(define-fun .y () Int (! y :next |y'|))
(define-fun .init () Bool (! (and (= x 0) (= y 0)) :init true))
(define-fun .trans () Bool (! (or (and (< x 3) (= |x'| (+ x 1)) (= |y'| y))
                                  (and (< y 3) (= |y'| (+ y 1)) (= |x'| x)))
                              :trans true))
(define-fun .bounded () Bool (! (and (<= x 3) (<= y 3)) :invar-property 0))
(define-fun .notboth () Bool (! (not (and (= x 3) (= y 3))) :invar-property 1))
(define-fun .live () Bool (! (= x 3) :live-property 2))
