; h is applied to a 2-bit state variable: values must stay consistent along the run
(declare-fun h ((_ BitVec 2)) Bool)
(declare-fun c () (_ BitVec 2))
(declare-fun c.n () (_ BitVec 2))
(declare-fun seen0 () Bool)
(declare-fun seen0.n () Bool)
(declare-fun bad () Bool)
(declare-fun bad.n () Bool)
(define-fun .c () (_ BitVec 2) (! c :next c.n))
(define-fun .s () Bool (! seen0 :next seen0.n))
(define-fun .b () Bool (! bad :next bad.n))
(define-fun .init () Bool (! (and (= c #b00) (not seen0) (not bad)) :init true))
(define-fun .trans () Bool (! (and (= c.n (bvadd c #b01))
                                   (= seen0.n (or seen0 (and (= c #b00) (h c))))
                                   (= bad.n (or bad (and seen0 (= c #b00) (not (h c))))))
                              :trans true))
(define-fun .p0 () Bool (! (not bad) :invar-property 0))
(define-fun .p1 () Bool (! (not seen0) :invar-property 1))
