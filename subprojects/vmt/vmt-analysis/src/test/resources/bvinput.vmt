; an 8-bit counter that steps only when the input en is true
(declare-fun c () (_ BitVec 8))
(declare-fun c.next () (_ BitVec 8))
(declare-fun flag () Bool)
(declare-fun flag.next () Bool)
(declare-fun en () Bool)
(define-fun step ((v (_ BitVec 8))) (_ BitVec 8) (bvadd v #x01))
(define-fun .c () (_ BitVec 8) (! c :next c.next))
(define-fun .flag () Bool (! flag :next flag.next))
(define-fun .init () Bool (! (and (= c #x00) (not flag)) :init true))
(define-fun .trans () Bool (! (and (= c.next (ite (and en (bvult c #x0a)) (step c) c))
                                   (= flag.next (or flag (= c #x0a))))
                              :trans true))
(define-fun .p0 () Bool (! (not (= c #x03)) :invar-property 0))
(define-fun .p1 () Bool (! (bvule c #x0a) :invar-property 1))
(define-fun .p2 () Bool (! (=> flag (= c #x0a)) :invar-property 2))
