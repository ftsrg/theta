(set-logic UFLIA)
(set-option :produce-witnesses true)
(set-info :format-version "1.0")

(declare-fun f (Int) Int)
(declare-fun c () Int)
(declare-const input Int)
(assert (< 0 c))

(define-proc check
  ((x Int))
  ()
  ()
  (!
    (sequence)
    :tag end
    :check-true (not (= (f x) c))))

(verify-call check (input))
(get-witness)
