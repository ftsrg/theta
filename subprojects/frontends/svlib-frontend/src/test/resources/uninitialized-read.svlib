(set-logic LIA)
(set-option :produce-witnesses true)
(set-info :format-version "1.0")

(define-proc uninitializedRead
  ((x0 Int))
  ((r Int))
  ((x Int) (y Int))
  (sequence
    (assign (y 1))
    (!
      (assign (x x0))
      :tag before-x)
    (if (<= 0 x0)
      (assign (r (+ x y))))))

(annotate-tag before-x
  :check-true (<= 0 x))

(declare-const input Int)

(verify-call uninitializedRead (input))
(get-witness)
