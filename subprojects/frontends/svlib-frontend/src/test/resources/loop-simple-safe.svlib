(set-logic LIA)
(set-option :produce-witnesses true)
(set-info :format-version "1.0")

(define-proc loopExample
  ((x0 Int))
  ((x Int))
  ()
  (sequence
    (assign (x x0))
    (while (< x 3)
      (assign (x (+ x 1))))
    (!
      (assign (x (+ x 1)))
      :tag check-before-increment
      :check-true (>= x 3))))

(declare-const input Int)

(verify-call loopExample (input))
(get-witness)
