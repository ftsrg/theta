(set-logic LIA)
(set-option :produce-witnesses true)
(set-info :format-version "1.0")

(define-proc multiAssignExample
  ((x0 Int))
  ((x Int) (y Int))
  ()
  (sequence
    (assign
      (x 0)
      (y 0))
    (assign
      (x (+ y 1))
      (y (+ x 1)))
    (!
      (sequence)
      :check-true (and (= x 1) (= y 1))))
  )


(declare-const input Int)

(verify-call multiAssignExample (input))
(get-witness)
